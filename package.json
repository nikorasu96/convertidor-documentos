{
  "name": "convertidor-documentos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.16.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:extractors": "tsx scripts/validate-extractors.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "file-saver": "2.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-window": "1.8.11",
    "unpdf": "1.6.2",
    "xlsx-populate": "1.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/file-saver": "2.0.7",
    "@types/node": "20.19.43",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/react-window": "1.8.8",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "14.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
