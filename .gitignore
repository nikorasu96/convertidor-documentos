# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# local env files

# lighthouse/unlighthouse reports
.unlighthouse/
unlighthouse-reports/

# temporary files
*.tmp
*.temp

# test / benchmark artifacts
.playwright-mcp/
.bench/
/public/samples

server.js
services.js
uninstall-service.js

/pdf pruebas

# claude code (ajustes personales)
.claude/settings.local.json

# Datos de terceros: nunca versionar documentos ni salidas (el repo es público)
*.pdf
*.xlsx
*.xls
*.csv

# Handoffs de sesión del plugin medidor-contexto (pueden citar patentes del corpus)
docs/handoffs/
